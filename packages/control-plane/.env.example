# local: loopback-only, trusts X-OpenSaddle-User from localhost.
# company: network listener, requires bearer keys from OPENSADDLE_API_KEYS_JSON.
OPENSADDLE_MODE=local
OPENSADDLE_PORT=8765
OPENSADDLE_DATA_DIR=.opensaddle
OPENSADDLE_BOOTSTRAP_ADMIN=user-ad

# Recommended hosted setup for now. Copy this file to `.env`, paste your key,
# and OpenSaddle will use OpenRouter's free-model router by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_APP_NAME=OpenSaddle
# Optional attribution shown by OpenRouter:
# OPENROUTER_SITE_URL=http://localhost:5173

# Use local workspaces on a user's computer, or Docker sandboxes on a server.
OPENSADDLE_RUNTIME_PROVIDER=local
OPENSADDLE_ALLOWED_REPO_ROOTS=/absolute/path/to/allowed/repos
OPENSADDLE_RUNTIME_TTL_MS=3600000
OPENSADDLE_MAX_CONCURRENT_RUNS=4

# Prefer the native OpenSaddle coding agent, or an installed CLI harness.
OPENSADDLE_DEFAULT_CODING_PROVIDER=opensaddle
OPENSADDLE_CODING_PROVIDERS=opensaddle,codex,claude,cursor,gemini,opencode

# Optional custom CLI harnesses (KRAIL-style). Prompt is appended as the final arg
# unless promptMode/promptFlag are set.
# OPENSADDLE_HARNESS_PROFILES_JSON=[{"id":"antigravity","label":"Antigravity","command":"antigravity-agent","description":"Custom local agent","kind":"cli","promptMode":"final_arg","codingAffinity":0.7,"supportsCancel":true,"supportsStreaming":false}]

# One OpenAI-compatible endpoint can be Ollama, vLLM, LM Studio, an enterprise
# model gateway, or a hosted provider. The API key is optional for local tools.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_MODEL=your-model-id
OPENAI_COMPATIBLE_API_KEY=

# For multiple model routes, use JSON. apiKeyEnv names a server environment
# variable; secrets never enter browser configuration or persisted state.
# OPENSADDLE_MODEL_ROUTES_JSON={"gpt":{"baseUrl":"https://gateway.example/v1","model":"approved-gpt","apiKeyEnv":"COMPANY_MODEL_KEY"},"llama":{"baseUrl":"http://127.0.0.1:11434/v1","model":"local-model"}}

# Company mode examples:
# OPENSADDLE_HOST=0.0.0.0
# OPENSADDLE_CORS_ORIGINS=https://agents.example.com
# OPENSADDLE_API_KEYS_JSON={"replace-with-32+-character-random-token":{"userId":"admin@example.com","roles":["admin"]}}
# OPENSADDLE_RUNTIME_PROVIDER=docker
# OPENSADDLE_DOCKER_IMAGE=ghcr.io/your-company/opensaddle-runtime:latest
