{
  "name": "opensaddle-interface",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "server": "npm run start --prefix packages/control-plane",
    "server:dev": "npm run dev --prefix packages/control-plane",
    "server:build": "npm run build --prefix packages/control-plane",
    "server:test": "npm test --prefix packages/control-plane",
    "server:typecheck": "npm run typecheck --prefix packages/control-plane",
    "real:check": "npm run typecheck && npm run lint && npm run server:typecheck && npm run server:test && npm run build && npm run server:build",
    "krail": "npm run start --prefix packages/krail",
    "electron:build": "npm run build --prefix electron",
    "electron:dev": "npm run build && npm run build --prefix electron && npm run start --prefix electron",
    "desktop": "npm run electron:dev",
    "desktop:package": "VITE_APP_BASE=./ npm run build && npm run package:mac --prefix electron"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
