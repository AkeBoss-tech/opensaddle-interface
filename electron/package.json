{
  "name": "opensaddle-desktop",
  "version": "0.1.0",
  "description": "OpenSaddle enterprise agent workspace desktop app",
  "author": "OpenSaddle",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp preload.cjs dist-electron/preload.cjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.2"
  },
  "build": {
    "appId": "com.opensaddle.desktop",
    "productName": "OpenSaddle",
    "files": [
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "renderer",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "assets/opensaddle-icon.png",
        "to": "opensaddle-icon.png"
      }
    ],
    "mac": {
      "icon": "assets/opensaddle-icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    }
  }
}
