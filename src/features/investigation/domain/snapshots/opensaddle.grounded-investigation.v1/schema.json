{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensaddle.example/contracts/opensaddle.grounded-investigation.v1/schema.json",
  "$defs": {
    "Digest": {"type":"object","additionalProperties":false,"required":["algorithm","value"],"properties":{"algorithm":{"const":"sha-256"},"value":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "SourceVersion": {"type":"object","additionalProperties":false,"required":["source_id","origin","version","digest"],"properties":{"source_id":{"type":"string","minLength":1,"maxLength":512},"origin":{"type":"string","format":"uri","maxLength":932},"version":{"type":"string","minLength":1,"maxLength":200},"digest":{"$ref":"#/$defs/Digest"}}},
    "ResourceRef": {"type":"object","additionalProperties":false,"required":["issuer","resource_id","resource_type","version","digest","source"],"properties":{"issuer":{"type":"string","format":"uri","maxLength":512},"resource_id":{"type":"string","minLength":1,"maxLength":512},"resource_type":{"enum":["repository","issue"]},"version":{"type":"string","minLength":1,"maxLength":256},"digest":{"$ref":"#/$defs/Digest"},"source":{"$ref":"#/$defs/SourceVersion"}}},
    "Failure": {"type":["object","null"],"additionalProperties":false,"required":["code","message","retryable"],"properties":{"code":{"enum":["policy_denied","approval_required","stale_evidence","version_conflict","provider_unavailable","invalid_evidence","cancelled"]},"message":{"type":"string","minLength":1,"maxLength":2048},"retryable":{"type":"boolean"}}},
    "PlanDraft": {"type":["object","null"],"additionalProperties":false,"required":["schema_version","title","objective","steps","assumptions","authored_by"],"properties":{"schema_version":{"const":"opensaddle.human-plan-draft.v1"},"title":{"type":"string","minLength":1,"maxLength":300},"objective":{"type":"string","minLength":1,"maxLength":4000},"steps":{"type":"array","minItems":1,"maxItems":100,"items":{"type":"string","minLength":1}},"assumptions":{"type":"array","maxItems":100,"items":{"type":"string"}},"authored_by":{"type":"string","minLength":1,"maxLength":200}}},
    "EvidenceRef": {"type":"object","additionalProperties":false,"required":["evidence_id","excerpt_digest","record_digest","resource","result_resource"],"properties":{"evidence_id":{"type":"string","minLength":1,"maxLength":512},"excerpt_digest":{"$ref":"#/$defs/Digest"},"record_digest":{"$ref":"#/$defs/Digest"},"resource":{"$ref":"#/$defs/ResourceRef"},"result_resource":{"$ref":"#/$defs/ResourceRef"}}},
    "FreshnessSummary": {"type":"object","additionalProperties":false,"required":["source","status","basis"],"properties":{"source":{"$ref":"#/$defs/ResourceRef"},"status":{"enum":["fresh","stale","unknown"]},"basis":{"type":"string","minLength":1,"maxLength":1024},"processing_version":{"type":"string","maxLength":200}}},
    "ConflictSummary": {"type":"object","additionalProperties":false,"required":["sources","basis"],"properties":{"sources":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/ResourceRef"}},"basis":{"type":"string","minLength":1,"maxLength":2048},"processing_version":{"type":"string","maxLength":200}}},
    "GapSummary": {"type":"object","additionalProperties":false,"required":["code","message"],"properties":{"code":{"type":"string","pattern":"^[a-z][a-z0-9-]*$","maxLength":128},"message":{"type":"string","minLength":1,"maxLength":2048}}},
    "DomainEventRef": {"type":["object","null"],"additionalProperties":false,"required":["event_type","event_digest"],"properties":{"schema_version":{"const":"krail.domain-event-ref.v1"},"event_type":{"type":"string","minLength":1,"maxLength":512},"event_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"operation_id":{"type":["string","null"],"maxLength":512},"correlation_id":{"type":["string","null"],"maxLength":512},"causation_id":{"type":["string","null"],"maxLength":512}}},
    "ContextBriefSummary": {"type":"object","additionalProperties":false,"required":["schema_version","brief_digest","repository","issue","evaluated_at","evidence_packet","freshness","conflicts","gaps","processing_versions","domain_event_ref","truncated"],"properties":{"schema_version":{"const":"krail.context-brief.v1"},"brief_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"repository":{"$ref":"#/$defs/ResourceRef"},"issue":{"$ref":"#/$defs/ResourceRef"},"evaluated_at":{"type":"string","format":"date-time"},"evidence_packet":{"type":"object","additionalProperties":false,"required":["packet_id","evidence_refs","authorization"],"properties":{"packet_id":{"type":"string","minLength":1,"maxLength":512},"evidence_refs":{"type":"array","maxItems":256,"items":{"$ref":"#/$defs/EvidenceRef"}},"authorization":{"type":"object","additionalProperties":false,"required":["shape","omissions_present","disclosure"],"properties":{"shape":{"const":"authorized_projection"},"omissions_present":{"type":"boolean"},"disclosure":{"type":["string","null"],"maxLength":512}}}}},"freshness":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/FreshnessSummary"}},"conflicts":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/ConflictSummary"}},"gaps":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/GapSummary"}},"processing_versions":{"type":"array","maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["component","version"],"properties":{"component":{"type":"string","minLength":1,"maxLength":200},"version":{"type":"string","minLength":1,"maxLength":200}}}},"domain_event_ref":{"$ref":"#/$defs/DomainEventRef"},"truncated":{"type":"boolean"}}},
    "CreateRequest": {"type":"object","additionalProperties":false,"required":["project_id","repository","issue","evaluated_at"],"properties":{"project_id":{"type":"string","minLength":1,"maxLength":200},"repository":{"$ref":"#/$defs/ResourceRef"},"issue":{"$ref":"#/$defs/ResourceRef"},"query":{"type":["string","null"],"minLength":1,"maxLength":8192},"evaluated_at":{"type":"string","format":"date-time"}}},
    "Projection": {"type":"object","additionalProperties":false,"required":["schema_version","investigation_id","outcome_thread_id","project_id","repository","issue","query","status","failure","attempt","context_brief","plan_draft","plan_version","plan_digest","operation_proposal","contract","created_at","updated_at"],"properties":{"schema_version":{"const":"opensaddle.grounded-investigation.v1"},"investigation_id":{"type":"string","pattern":"^inv_[a-f0-9]{32}$"},"outcome_thread_id":{"type":"string","pattern":"^thread_[a-f0-9]{32}$"},"project_id":{"type":"string"},"repository":{"$ref":"#/$defs/ResourceRef"},"issue":{"$ref":"#/$defs/ResourceRef"},"query":{"type":["string","null"]},"status":{"enum":["pending","ready","needs_attention","failed","cancelled"]},"failure":{"$ref":"#/$defs/Failure"},"attempt":{"type":"integer","minimum":1},"context_brief":{"anyOf":[{"$ref":"#/$defs/ContextBriefSummary"},{"type":"null"}]},"plan_draft":{"$ref":"#/$defs/PlanDraft"},"plan_version":{"type":"integer","minimum":0},"plan_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"operation_proposal":{"type":"object","additionalProperties":false,"required":["path","proposal_id","execution_available","protected_input_digest"],"properties":{"path":{"const":"/api/v2/operation-proposals"},"proposal_id":{"type":["string","null"]},"execution_available":{"const":false},"protected_input_digest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}},"contract":{"type":"object","additionalProperties":false,"required":["capability_id","descriptor_digest","manifest_digest","source_commit"],"properties":{"capability_id":{"const":"krail.context-brief.opensaddle-v1"},"descriptor_digest":{"const":"sha256:bfe1bd6af513f24df70b59617565a2262610119f13d0a8a7fb937fbca70098fd"},"manifest_digest":{"const":"sha256:3fa4bb326946fe0555321b0790150dbbb2a92964fba23eae492f448e8c0655a7"},"source_commit":{"const":"21da6d42619410e8d1cfc4f823681e4eac47d21a"}}},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"}}}
  }
}
