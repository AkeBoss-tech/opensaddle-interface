{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensaddle.example/contracts/opensaddle.edit-command.v1/schema.json",
  "title": "OpenSaddle edit-command client contract",
  "$defs": {
    "Digest": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "ShaDigest": {"type":"object","additionalProperties":false,"required":["algorithm","value"],"properties":{"algorithm":{"const":"sha-256"},"value":{"$ref":"#/$defs/Digest"}}},
    "SourceVersion": {"type":"object","additionalProperties":false,"required":["source_id","origin","version","digest"],"properties":{"source_id":{"type":"string","minLength":1,"maxLength":512},"origin":{"type":"string","format":"uri","maxLength":932},"version":{"type":"string","minLength":1,"maxLength":200},"digest":{"$ref":"#/$defs/ShaDigest"}}},
    "ResourceRef": {"type":"object","additionalProperties":false,"required":["issuer","resource_id","resource_type","version","digest","source"],"properties":{"issuer":{"type":"string","format":"uri","maxLength":512},"resource_id":{"type":"string","minLength":1,"maxLength":512},"resource_type":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},"version":{"type":"string","minLength":1,"maxLength":256},"digest":{"$ref":"#/$defs/ShaDigest"},"source":{"$ref":"#/$defs/SourceVersion"}}},
    "Author": {"type":"object","additionalProperties":false,"required":["subject","kind","delegation_id","delegator"],"properties":{"subject":{"type":"string","minLength":1,"maxLength":200},"kind":{"enum":["human","agent"]},"delegation_id":{"type":["string","null"],"maxLength":200},"delegator":{"type":["string","null"],"maxLength":200}}},
    "FieldRule": {"type":"object","additionalProperties":false,"required":["field","kind","required","maximum_length"],"properties":{"field":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"kind":{"enum":["string","boolean","integer","string_list"]},"required":{"type":"boolean"},"maximum_length":{"type":"integer","minimum":1,"maximum":65536}}},
    "ResourceSchema": {"type":"object","additionalProperties":false,"required":["resource_type","fields","low_risk_draft_commit"],"properties":{"resource_type":{"type":"string","minLength":1,"maxLength":200},"fields":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/FieldRule"}},"low_risk_draft_commit":{"type":"boolean"}}},
    "ConsequentialAction": {"type":"object","additionalProperties":false,"required":["registered_action_id","registered_action_version","registered_action_digest","effect_class","requires_proposal"],"properties":{"registered_action_id":{"type":"string","pattern":"^act_[A-Za-z0-9]+$","maxLength":200},"registered_action_version":{"type":"integer","minimum":1},"registered_action_digest":{"$ref":"#/$defs/Digest"},"effect_class":{"enum":["external_write","code_mutation","runtime_execution","destructive"]},"requires_proposal":{"const":true}}},
    "Capability": {"type":"object","additionalProperties":false,"required":["schema_version","capability_id","capability_version","issuer","resource_schemas","consequential_action","effects","capability_digest"],"properties":{"schema_version":{"const":"opensaddle.edit-capability.v1"},"capability_id":{"type":"string","minLength":1,"maxLength":200},"capability_version":{"type":"integer","minimum":1},"issuer":{"type":"string","format":"uri"},"resource_schemas":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/ResourceSchema"}},"consequential_action":{"$ref":"#/$defs/ConsequentialAction"},"effects":{"type":"object","additionalProperties":false,"required":["draft_edit","external_effects"],"properties":{"draft_edit":{"const":true},"external_effects":{"const":false}}},"capability_digest":{"$ref":"#/$defs/Digest"}}},
    "PatchOperation": {"type":"object","additionalProperties":false,"required":["operation","field"],"properties":{"operation":{"enum":["set","remove"]},"field":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"value":{}},"allOf":[{"if":{"properties":{"operation":{"const":"set"}}},"then":{"required":["value"]}},{"if":{"properties":{"operation":{"const":"remove"}}},"then":{"not":{"required":["value"]}}}]},
    "Patch": {"type":"object","additionalProperties":false,"required":["schema_version","operations"],"properties":{"schema_version":{"const":"opensaddle.typed-patch.v1"},"operations":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/PatchOperation"}}}},
    "Session": {"type":"object","additionalProperties":false,"required":["schema_version","session_id","project_id","capability_id","capability_version","capability_digest","resource_ref","author","version","draft_digest","resource_state","last_autosaved_at","recovery_token_digest","history_length"],"properties":{"schema_version":{"const":"opensaddle.edit-session.v1"},"session_id":{"type":"string","pattern":"^edit_[a-f0-9]{32}$"},"project_id":{"type":"string","minLength":1,"maxLength":200},"capability_id":{"type":"string"},"capability_version":{"type":"integer","minimum":1},"capability_digest":{"$ref":"#/$defs/Digest"},"resource_ref":{"$ref":"#/$defs/ResourceRef"},"author":{"$ref":"#/$defs/Author"},"version":{"type":"integer","minimum":0},"draft_digest":{"$ref":"#/$defs/Digest"},"resource_state":{"enum":["draft","published"]},"last_autosaved_at":{"type":"string","format":"date-time"},"recovery_token_digest":{"$ref":"#/$defs/Digest"},"history_length":{"type":"integer","minimum":0,"maximum":128}}},
    "ValidationFinding": {"type":"object","additionalProperties":false,"required":["code","level","field","disclosure"],"properties":{"code":{"type":"string","minLength":1,"maxLength":200},"level":{"enum":["info","warning","error"]},"field":{"type":["string","null"],"maxLength":128},"disclosure":{"type":"string","minLength":1,"maxLength":1024}}},
    "Diff": {"type":"object","additionalProperties":false,"required":["changed_fields","before_digest","after_digest","validation"],"properties":{"changed_fields":{"type":"array","maxItems":128,"uniqueItems":true,"items":{"type":"string"}},"before_digest":{"$ref":"#/$defs/Digest"},"after_digest":{"$ref":"#/$defs/Digest"},"validation":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/ValidationFinding"}}}},
    "HistoryEntry": {"type":"object","additionalProperties":false,"required":["index","patch_digest","before_digest","after_digest","author","at"],"properties":{"index":{"type":"integer","minimum":0,"maximum":127},"patch_digest":{"$ref":"#/$defs/Digest"},"before_digest":{"$ref":"#/$defs/Digest"},"after_digest":{"$ref":"#/$defs/Digest"},"author":{"$ref":"#/$defs/Author"},"at":{"type":"string","format":"date-time"}}},
    "Result": {"type":"object","additionalProperties":false,"required":["schema_version","session","diff","applied","rebased","omissions_present","proposal_required","published"],"properties":{"schema_version":{"const":"opensaddle.edit-result.v1"},"session":{"$ref":"#/$defs/Session"},"diff":{"$ref":"#/$defs/Diff"},"applied":{"type":"boolean"},"rebased":{"type":"boolean"},"omissions_present":{"type":"boolean"},"proposal_required":{"type":"boolean"},"published":{"type":"boolean"}}},
    "ProposalInput": {"type":"object","additionalProperties":false,"required":["project_id","registered_action_id","registered_action_version","delegation_chain","targets","protected_input_digest","validation_results","cost_estimate","correlation_ids","expires_in_seconds"],"properties":{"project_id":{"type":"string","minLength":1,"maxLength":200},"registered_action_id":{"type":"string","pattern":"^act_[A-Za-z0-9]+$","maxLength":200},"registered_action_version":{"type":"integer","minimum":1},"delegation_chain":{"type":"array","maxItems":32,"items":{"type":"string","minLength":1,"maxLength":200}},"targets":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"object","additionalProperties":false,"required":["resource_ref","expected_version"],"properties":{"resource_ref":{"$ref":"#/$defs/ResourceRef"},"expected_version":{"type":"string","minLength":1,"maxLength":256}}}},"protected_input_digest":{"$ref":"#/$defs/Digest"},"validation_results":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,"required":["code","passed","message"],"properties":{"code":{"type":"string","minLength":1,"maxLength":200},"passed":{"type":"boolean"},"message":{"type":["string","null"],"maxLength":1000}}}},"cost_estimate":{"type":"object","additionalProperties":false,"required":["currency","estimated_microunits","budget_microunits"],"properties":{"currency":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,15}$"},"estimated_microunits":{"type":"integer","minimum":0},"budget_microunits":{"type":["integer","null"],"minimum":0}}},"correlation_ids":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"}},"expires_in_seconds":{"type":"integer","minimum":60,"maximum":86400}}}
  },
  "oneOf": [
    {"$ref":"#/$defs/Capability"},
    {"$ref":"#/$defs/Patch"},
    {"$ref":"#/$defs/Session"},
    {"$ref":"#/$defs/Result"},
    {"$ref":"#/$defs/ProposalInput"}
  ]
}
